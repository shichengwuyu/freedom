# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=freedom

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=freedom
JWT_EXPIRE_HOURS=168

# 供应商凭证加密密钥（AES-256-GCM）。
# 正式部署必须配置一个固定的强随机密钥（建议 32+ 字符），否则重启后已加密的供应商 Cookie/Token 无法解密。
# 留空时 dev 模式自动生成临时密钥（重启后失效）。
# VENDOR_CREDENTIAL_KEY=

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取，
# 也用于邀请链接域名（钱包页「我的邀请」用 window.location.origin 动态生成，
# 部署后自动为真实域名；本地开发为 localhost:3000）。
# 线上部署时填写站点根地址，例如：https://xiaoyxiao.xyz
# PUBLIC_BASE_URL=https://xiaoyxiao.xyz

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置：默认使用本地 MySQL。
STORAGE_DRIVER=mysql
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
DATABASE_DSN=freedom:freedom123@tcp(127.0.0.1:3306)/freedom?parseTime=true&charset=utf8mb4&loc=Local

# 卡密购买跳转页（链动小铺 shop 链接）。默认 ldxp.cn/shop/35TCHF9A，线上如需换链接可覆盖。
# LICENSE_PURCHASE_URL=https://pay.ldxp.cn/shop/35TCHF9A

# CORS 允许的来源（逗号分隔）。
# 生产部署时设置为你前端实际域名，否则浏览器跨域会被拦（邀请/充值等接口全挂）。
# 推荐直接填 PUBLIC_BASE_URL 同值；两者填一个即可自动加白名单。
# CORS_ALLOWED_ORIGINS=https://xiaoyxiao.xyz
